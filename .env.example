# ============ 云购数仓 · 环境变量模板 ============
# 用法：cp .env.example .env  然后填入真实值；.env 已被 .gitignore 排除，严禁提交

# --- MySQL（Metastore 元数据库） ---
MYSQL_ROOT_PASSWORD=root123
MYSQL_HIVE_PASSWORD=hive123

# --- ClickHouse ---
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# --- Superset ---
SUPERSET_SECRET_KEY=please_generate_a_random_string

# --- 大模型 API（NL2SQL / 洞察） ---
# 支持任意 OpenAI 协议服务：智谱 GLM / DeepSeek / 通义 等
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
LLM_MODEL=glm-4-flash
